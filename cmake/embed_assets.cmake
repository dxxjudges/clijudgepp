# embed_assets.cmake
# 将 assets/ 下的静态文件生成 web_assets.hpp（CMake 脚本模式，无外部依赖）
#
# 用法:
#   cmake -DASSETS_DIR=<dir> -DOUTPUT_FILE=<file> -P embed_assets.cmake

if(NOT DEFINED ASSETS_DIR OR NOT DEFINED OUTPUT_FILE)
  message(FATAL_ERROR "ASSETS_DIR and OUTPUT_FILE are required")
endif()

file(GLOB ASSET_FILES "${ASSETS_DIR}/*")
if(NOT ASSET_FILES)
  message(FATAL_ERROR "no assets found in ${ASSETS_DIR}")
endif()

set(GEN "// Generated by cmake/embed_assets.cmake - do not edit\n")
string(APPEND GEN "#pragma once\n")
string(APPEND GEN "#include <string>\n")
string(APPEND GEN "#include <map>\n\n")
string(APPEND GEN "namespace clijudge { namespace gui { namespace assets {\n\n")
string(APPEND GEN "struct Asset { const char* mime; const char* data; };\n\n")
string(APPEND GEN "inline const std::map<std::string, Asset>& files() {\n")
string(APPEND GEN "    static const std::map<std::string, Asset> kFiles = {\n")

foreach(_f ${ASSET_FILES})
  get_filename_component(_name "${_f}" NAME)
  file(READ "${_f}" _data)
  if(_name MATCHES "\\.html$")
    set(_mime "text/html; charset=utf-8")
  elseif(_name MATCHES "\\.css$")
    set(_mime "text/css; charset=utf-8")
  elseif(_name MATCHES "\\.js$")
    set(_mime "application/javascript; charset=utf-8")
  elseif(_name MATCHES "\\.svg$")
    set(_mime "image/svg+xml")
  elseif(_name MATCHES "\\.png$")
    set(_mime "image/png")
  else()
    set(_mime "application/octet-stream")
  endif()
  string(APPEND GEN "        {\"${_name}\", {\"${_mime}\", R\"CLJASSET(\n${_data}\n)CLJASSET\"}},\n")
endforeach()

string(APPEND GEN "    };\n")
string(APPEND GEN "    return kFiles;\n")
string(APPEND GEN "}\n\n")
string(APPEND GEN "}}} // namespace clijudge::gui::assets\n")

file(WRITE "${OUTPUT_FILE}" "${GEN}")
message(STATUS "Generated ${OUTPUT_FILE} (${ARGC} args)")
